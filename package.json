{
  "name": "@webship.co/workspace-ai-agents",
  "version": "1.0.12",
  "description": "The AI Agents workspace for Webship Workspace: the `ai-agents/` folder (type ai-items), its settings file, its 2 commands, its docs and its AI items (an agent, a skill, a command and a prompt, each in the folder of its kind), activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-ai-agents.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "docs",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "ai-agents",
    "label": "AI Agents",
    "workspace": {
      "key": "ai-agents",
      "settingsTemplate": "config/workspace.ai-agents.settings.yml",
      "files": [
        "commands/cmd-tool-backup-agent.sh",
        "commands/cmd-tools-ai-items.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/ai-agents-keeper.md"
      ],
      "skills": [
        "ai/skills/ai-agents-workflow"
      ],
      "commands": [
        "ai/commands/ai-agents-install.md"
      ],
      "prompts": [
        "ai/prompts/ai-agents-write-a-new-agent.md"
      ]
    },
    "features": [
      "features/ai-agents.feature"
    ],
    "suggests": [
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
